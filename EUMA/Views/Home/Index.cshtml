@model IReadOnlyList<EUMA.Models.Producto>
@{
    ViewData["Title"] = "Catálogo";
}

<section class="py-4 py-md-5">
    <div class="mb-4">
        <p class="text-uppercase text-muted small mb-2">EUMA · Tienda de esencias</p>
        <h1 class="display-5">Nuestro catálogo</h1>
        <p class="lead text-muted">Descubrí nuestras esencias y sus presentaciones.</p>
    </div>
    @if (Model.Count == 0)
    {
        <p class="alert alert-light border">Todavía no hay productos disponibles en el catálogo.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
            @foreach (var producto in Model)
            {
                <div class="col">
                    <article class="card h-100 shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(producto.Imagen))
                        {
                            <img src="@producto.Imagen" class="card-img-top object-fit-cover" style="height: 220px" alt="@producto.Nombre" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center text-muted" style="height: 220px">Sin imagen</div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h2 class="h5 card-title">@producto.Nombre</h2>
                            <p class="text-muted mb-2">@producto.Presentacion</p>
                            <p class="fs-5 fw-semibold mb-3">@producto.Precio.ToString("C")</p>
                            <p class="mb-0 mt-auto">@(producto.Stock > 0 ? "Disponible" : "Sin stock")</p>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>
