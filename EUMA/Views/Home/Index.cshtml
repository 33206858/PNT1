@model List<Producto>
@{
    ViewData["Title"] = "Catálogo";
    List<Categoria> categorias = ViewBag.Categorias;
    int? categoriaElegida = ViewBag.CategoriaId;
    string? buscar = ViewBag.Buscar;
}

<h1 class="mb-4">Catálogo</h1>

<div class="row g-4">
    @* Columna izquierda: categorías *@
    <aside class="col-md-3">
        <h2 class="h6 text-uppercase text-muted">Categorías</h2>
        <div class="list-group">
            @{
                string claseTodas = "list-group-item list-group-item-action";
                if (categoriaElegida == null)
                {
                    claseTodas = claseTodas + " active";
                }
            }
            <a asp-action="Index" asp-route-buscar="@buscar" class="@claseTodas">Todas</a>
            @foreach (var categoria in categorias)
            {
                string clase = "list-group-item list-group-item-action";
                if (categoria.Id == categoriaElegida)
                {
                    clase = clase + " active";
                }
                <a asp-action="Index" asp-route-categoriaId="@categoria.Id" asp-route-buscar="@buscar" class="@clase">@categoria.Nombre</a>
            }
        </div>
    </aside>

    <div class="col-md-9">
        @* Buscador: viaja en la URL (método GET) *@
        <form asp-action="Index" method="get" class="d-flex gap-2 mb-4">
            <input type="hidden" name="categoriaId" value="@categoriaElegida" />
            <input type="text" id="buscar" name="buscar" value="@buscar" maxlength="50" class="form-control"
                   placeholder="Buscar por nombre o código" aria-label="Buscar por nombre o código" />
            <button type="submit" class="btn btn-primary">Buscar</button>
        </form>

        @if (Model.Count == 0)
        {
            <div class="alert alert-light border">No encontramos productos. Probá con otra búsqueda o categoría.</div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
                @foreach (var producto in Model)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            @if (string.IsNullOrWhiteSpace(producto.Imagen))
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center text-muted" style="height: 200px">Sin imagen</div>
                            }
                            else
                            {
                                <img src="~/img/@producto.Imagen" class="card-img-top" style="height: 200px; object-fit: cover" alt="@producto.Nombre" />
                            }
                            <div class="card-body d-flex flex-column">
                                <h2 class="h5 card-title">@producto.Nombre</h2>
                                <p class="text-muted mb-1">@producto.Presentacion</p>
                                <p class="fs-5 fw-semibold mb-3">@producto.Precio.ToString("C")</p>
                                <div class="mt-auto d-grid gap-2">
                                    <a asp-action="Detalle" asp-route-id="@producto.Id" class="btn btn-outline-primary">Ver detalle</a>
                                    @if (producto.Stock > 0)
                                    {
                                        @* Agrega 1 unidad. El precio no se manda: lo pone el servidor. *@
                                        <form asp-controller="Carrito" asp-action="Agregar" method="post" class="d-grid">
                                            <input type="hidden" name="productoId" value="@producto.Id" />
                                            <input type="hidden" name="cantidad" value="1" />
                                            <button type="submit" class="btn btn-primary">Agregar al carrito</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-secondary" disabled>Sin stock</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
