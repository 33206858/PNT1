@model Carrito
@{
    ViewData["Title"] = "Carrito";
}

<h1 class="mb-4">Tu carrito</h1>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-light border">
        Tu carrito está vacío. <a asp-controller="Home" asp-action="Index">Ver el catálogo</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Precio unitario</th>
                    <th>Cantidad</th>
                    <th>Subtotal</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.Precio.ToString("C")</td>
                        <td>
                            <form asp-action="CambiarCantidad" method="post" class="d-flex gap-2">
                                <input type="hidden" name="productoId" value="@item.ProductoId" />
                                <input type="number" id="cantidad-@item.ProductoId" name="cantidad" value="@item.Cantidad" min="1"
                                       class="form-control" style="max-width: 90px" aria-label="Cantidad de @item.Nombre" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Actualizar</button>
                            </form>
                        </td>
                        <td>@item.Subtotal().ToString("C")</td>
                        <td>
                            <form asp-action="Quitar" method="post">
                                <input type="hidden" name="productoId" value="@item.ProductoId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Quitar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total</th>
                    <th>@Model.Total().ToString("C")</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="d-flex flex-wrap justify-content-between gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Seguir comprando</a>
    </div>
}
