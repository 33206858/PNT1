@model Pedido
@{
    ViewData["Title"] = "Pago del pedido " + Model.Id;
}

<h1 class="mb-1">Pedido número @Model.Id</h1>
<p class="text-muted">Estado: <strong>@Html.DisplayFor(m => m.Estado)</strong></p>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Precio unitario</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var detalle in Model.Detalles)
            {
                <tr>
                    <td>@detalle.Producto.Nombre</td>
                    <td>@detalle.Cantidad</td>
                    <td>@detalle.PrecioUnitario.ToString("C")</td>
                    <td>@detalle.Subtotal().ToString("C")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Total</th>
                <th>@Model.Total().ToString("C")</th>
            </tr>
        </tfoot>
    </table>
</div>

@if (Model.Estado == EstadoPedido.PendienteDePago)
{
    @* El botón Pagar solo aparece si el pedido está pendiente de pago. *@
    <form asp-action="Pagar" asp-route-id="@Model.Id" method="post" class="mb-2">
        <button type="submit" class="btn btn-success btn-lg">Pagar @Model.Total().ToString("C")</button>
    </form>
    <p class="text-muted small">Pago simulado: no se cobra dinero real.</p>
}
else
{
    <p>
        Guardá tu número de pedido (<strong>@Model.Id</strong>) para seguirlo en
        <a asp-controller="Home" asp-action="Index">la tienda</a>.
        La empresa se va a comunicar con vos para coordinar la entrega.
    </p>
}
