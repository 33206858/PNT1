@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Ocurrió un error</h1>
<p>No pudimos procesar tu pedido. Volvé a intentar en unos minutos.</p>

@if (Model.ShowRequestId)
{
    <p class="text-muted small">Código del error: <code>@Model.RequestId</code></p>
}

<a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver a la tienda</a>
