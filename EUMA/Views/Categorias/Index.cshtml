@model IEnumerable<Categoria>
@{ ViewData["Title"] = "Categorías"; }
<h1>Categorías</h1>
<p>Categorías disponibles para clasificar los productos.</p>
<p><a asp-action="Create" class="btn btn-primary">Nueva categoría</a></p>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Nombre</th><th>Descripción</th><th>Productos</th><th>Acciones</th></tr></thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="4">Todavía no hay registros.</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Descripcion</td>
                    <td>@item.Productos.Count</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id">Detalle</a> |
                        <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
