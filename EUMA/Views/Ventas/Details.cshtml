@model Pedido
@{ ViewData["Title"] = "Pedido número " + Model.Id; }
<h1>Pedido número @Model.Id</h1>
<dl class="row">
    <dt class="col-sm-3">Fecha</dt><dd class="col-sm-9">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-3">Estado</dt><dd class="col-sm-9">@Html.DisplayFor(m => m.Estado)</dd>
    <dt class="col-sm-3">Fecha de pago</dt>
    <dd class="col-sm-9">
        @if (Model.FechaPago != null)
        {
            @Model.FechaPago.Value.ToString("dd/MM/yyyy HH:mm")
        }
        else
        {
            <span>Sin pago registrado</span>
        }
    </dd>
    <dt class="col-sm-3">Cliente</dt><dd class="col-sm-9">@Model.Cliente.NombreCompleto()</dd>
    <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Cliente.Email</dd>
    <dt class="col-sm-3">Teléfono</dt><dd class="col-sm-9">@Model.Cliente.Telefono</dd>
    <dt class="col-sm-3">Forma de entrega</dt><dd class="col-sm-9">@Html.DisplayFor(m => m.Entrega)</dd>
    <dt class="col-sm-3">Dirección</dt><dd class="col-sm-9">@Model.Direccion</dd>
    <dt class="col-sm-3">Localidad</dt><dd class="col-sm-9">@Model.Localidad</dd>
    <dt class="col-sm-3">Código postal</dt><dd class="col-sm-9">@Model.CodigoPostal</dd>
    <dt class="col-sm-3">Observaciones</dt><dd class="col-sm-9">@Model.Observaciones</dd>
</dl>
<div class="table-responsive">
    <table class="table table-striped">
        <thead><tr><th>Producto</th><th>Cantidad</th><th>Precio unitario</th><th>Subtotal</th></tr></thead>
        <tbody>
            @foreach (var detalle in Model.Detalles)
            {
                <tr><td>@detalle.Producto.Nombre</td><td>@detalle.Cantidad</td><td>@detalle.PrecioUnitario.ToString("C")</td><td>@detalle.Subtotal().ToString("C")</td></tr>
            }
        </tbody>
        <tfoot><tr><th colspan="3" class="text-end">Total</th><th>@Model.Total().ToString("C")</th></tr></tfoot>
    </table>
</div>
<div class="d-flex flex-wrap gap-2 mb-3">
    @if (Model.Estado == EstadoPedido.Pagado && Model.Entrega == FormaEntrega.EnvioADomicilio)
    {
        <form asp-action="MarcarEnviado" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-primary">Marcar como enviado</button>
        </form>
    }
    @if (Model.Estado == EstadoPedido.Enviado)
    {
        <form asp-action="MarcarEntregado" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-success">Marcar como entregado</button>
        </form>
    }
    @if (Model.Estado == EstadoPedido.Pagado && Model.Entrega == FormaEntrega.RetiroEnLocal)
    {
        <form asp-action="MarcarEntregado" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-success">Confirmar entrega en local</button>
        </form>
    }
    @if (Model.Estado == EstadoPedido.PendienteDePago || Model.Estado == EstadoPedido.Pagado)
    {
        <form asp-action="Cancelar" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('¿Seguro que querés cancelar el pedido?');">
            <button type="submit" class="btn btn-danger">Cancelar pedido</button>
        </form>
    }
</div>
<a asp-action="Index" class="btn btn-outline-secondary">Volver a ventas</a>
