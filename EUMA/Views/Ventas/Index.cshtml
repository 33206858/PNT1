@model IEnumerable<Pedido>
@{
    ViewData["Title"] = "Ventas";
    var estados = Html.GetEnumSelectList<EstadoPedido>();
    foreach (var opcion in estados)
    {
        if (ViewBag.Estado != null)
        {
            opcion.Selected = opcion.Value == ((int)ViewBag.Estado).ToString();
        }
    }
}
<h1>Ventas</h1>
<form asp-action="Index" method="get" class="row g-3 mb-3">
    <div class="col-md-6">
        <label for="estado" class="form-label">Estado</label>
        <select id="estado" name="estado" asp-items="estados" class="form-select"><option value="">Todos</option></select>
    </div>
    <div class="col-md-3 align-self-end"><button type="submit" class="btn btn-primary">Filtrar</button></div>
</form>
<div class="table-responsive">
    <table class="table table-striped">
        <thead><tr><th>Número</th><th>Fecha</th><th>Cliente</th><th>Total</th><th>Estado</th><th>Acciones</th></tr></thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="6">No se encontraron pedidos.</td></tr>
            }
            @foreach (var pedido in Model)
            {
                <tr>
                    <td>@pedido.Id</td><td>@pedido.Fecha.ToString("dd/MM/yyyy HH:mm")</td><td>@pedido.Cliente.NombreCompleto()</td>
                    <td>@pedido.Total().ToString("C")</td><td>@Html.DisplayFor(m => pedido.Estado)</td>
                    <td><a asp-action="Details" asp-route-id="@pedido.Id">Ver</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
