@model IEnumerable<CEUMA.Models.Producto>

<h1>Productos</h1>

<table class="table">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Presentación</th>
            <th>Precio</th>
            <th>Stock</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.Codigo</td>
                <td>@producto.Nombre</td>
                <td>@producto.Presentacion</td>
                <td>@producto.Precio.ToString("C")</td>
                <td>@producto.Stock</td>
            </tr>
        }
    </tbody>
</table>
