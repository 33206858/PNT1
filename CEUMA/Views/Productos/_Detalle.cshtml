@model Producto
<dl class="row">
<dt class="col-sm-3">@Html.DisplayNameFor(m => m.Codigo)</dt><dd class="col-sm-9">@Html.DisplayFor(m => m.Codigo)</dd>
<dt class="col-sm-3">@Html.DisplayNameFor(m => m.Nombre)</dt><dd class="col-sm-9">@Html.DisplayFor(m => m.Nombre)</dd>
<dt class="col-sm-3">@Html.DisplayNameFor(m => m.Descripcion)</dt><dd class="col-sm-9">@Html.DisplayFor(m => m.Descripcion)</dd>
<dt class="col-sm-3">@Html.DisplayNameFor(m => m.Categoria.Nombre)</dt><dd class="col-sm-9">@Html.DisplayFor(m => m.Categoria.Nombre)</dd>
<dt class="col-sm-3">@Html.DisplayNameFor(m => m.Origen)</dt><dd class="col-sm-9">@Html.DisplayFor(m => m.Origen)</dd>
<dt class="col-sm-3">@Html.DisplayNameFor(m => m.Presentacion)</dt><dd class="col-sm-9">@Html.DisplayFor(m => m.Presentacion)</dd>
<dt class="col-sm-3">@Html.DisplayNameFor(m => m.Precio)</dt><dd class="col-sm-9">@Html.DisplayFor(m => m.Precio)</dd>
<dt class="col-sm-3">@Html.DisplayNameFor(m => m.Stock)</dt><dd class="col-sm-9">@Html.DisplayFor(m => m.Stock)</dd>
<dt class="col-sm-3">@Html.DisplayNameFor(m => m.Imagen)</dt><dd class="col-sm-9">@Html.DisplayFor(m => m.Imagen)</dd>
<dt class="col-sm-3">@Html.DisplayNameFor(m => m.Activo)</dt><dd class="col-sm-9">@Html.DisplayFor(m => m.Activo)</dd>
</dl>